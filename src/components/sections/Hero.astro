---
import { Picture } from 'astro:assets';
import hero from '../../assets/images/hero.jpg';
import SectionLabel from '../ui/SectionLabel.astro';
import Button from '../ui/Button.astro';
import TopoPattern from '../ui/TopoPattern.astro';
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <TopoPattern class="hero__topo" />
  <div class="hero__text">
    <SectionLabel rule="before">Espacios. Creados con intención.</SectionLabel>
    <h1 id="hero-title" class="h-display hero__title">
      Arquitectura<br />que eleva
      <em>la vida.</em>
    </h1>
    <p class="hero__copy">
      Northline Atelier es un estudio de arquitectura e interiores que crea espacios atemporales que equilibran belleza, propósito y lugar.
    </p>
    <Button href="#projects" arrow class="hero__cta">Explore nuestra obra</Button>
  </div>
  <div class="hero__img">
    <Picture
      src={hero}
      alt="Terraza de piedra bajo un amplio alero en voladizo, con muro de cristal, un banco de piedra y un árbol al fondo"
      widths={[800, 1200, 1700]}
      sizes="(max-width: 1023px) 100vw, 60vw"
      loading="eager"
      fetchpriority="high"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={72}
    />
  </div>
</section>
