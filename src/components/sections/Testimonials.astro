---
import { testimonials } from '../../data/testimonials';
import SectionLabel from '../ui/SectionLabel.astro';
---
<section id="testimonials" class="block" aria-labelledby="testimonials-title">
  <div class="block-inner">
    <div class="block__head">
      <SectionLabel rule="after">Diario · Opiniones</SectionLabel>
      <h2 id="testimonials-title" class="h-section">Lo que dicen los clientes sobre trabajar con nosotros.</h2>
      <p class="demo-note">Testimonios de demostración: contenido ilustrativo, no corresponde a opiniones reales de clientes.</p>
    </div>
    <div class="quote-grid">
      {testimonials.map((t, i) => (
        <figure class="quote" style="margin:0" data-reveal data-reveal-delay={i * 0.08}>
          <blockquote class="quote__text" style="margin:0">&ldquo;{t.quote}&rdquo;</blockquote>
          <figcaption class="quote__by">{t.author} · {t.context}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
