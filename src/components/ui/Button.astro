---
import ThinArrow from './ThinArrow.astro';
interface Props {
  variant?: 'solid' | 'outline';
  href?: string;
  type?: 'button' | 'submit';
  arrow?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { variant = 'solid', href, type = 'button', arrow = false, class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const attrs = href ? { href } : { type };
---
<Tag class:list={['btn', `btn--${variant}`, cls]} {...attrs} {...rest}>
  <span><slot /></span>
  {arrow && <ThinArrow />}
</Tag>
