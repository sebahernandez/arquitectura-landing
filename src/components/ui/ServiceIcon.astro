---
interface Props { name: 'architecture' | 'interior' | 'planning' | 'furnishings'; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="miter" aria-hidden="true" focusable="false">
  {name === 'architecture' && (<>
    <path d="M5 36V19C5 9 11 4 20 4s15 5 15 15v17Z" />
    <path d="M13 36V22c0-4 3-7 7-7s7 3 7 7v14" />
    <path d="M20 15V4" />
  </>)}
  {name === 'interior' && (<>
    <circle cx="20" cy="20" r="15.5" />
    <path d="M4.8 14h30.4M4.5 20h31M5 26h30M8 31.5h24" />
  </>)}
  {name === 'planning' && (<>
    <rect x="4.5" y="4.5" width="31" height="31" />
    <path d="M4.5 35.5 35.5 4.5M22 4.5v31" />
    <path d="M4.5 16h13" />
  </>)}
  {name === 'furnishings' && (<>
    <path d="M4 5h32M4 5l4 30M8 18l26 2M8 18V5M36 5l-2 15M34 20l-2 15M20 19v16" />
  </>)}
</svg>
