  </g>
  <g font-family="Jost, sans-serif" font-size="7.5" letter-spacing="1.4" fill="currentColor" stroke="none">
    <text x="8" y="95">WALK-IN</text><text x="8" y="105">CLOSET</text>
    <text x="22" y="312">BEDROOM 2</text>
    <text x="196" y="260">BEDROOM 3</text>
    <text x="344" y="262">BATH</text>
