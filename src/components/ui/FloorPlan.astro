  <path d="M0 40v100M0 260v90" stroke-width="2.2" />
  <!-- door swings -->
  <path d="M60 110a28 28 0 0 1 28 28M96 300a24 24 0 0 0 24-24M242 220a30 30 0 0 1 30-30M182 350a24 24 0 0 1 24-24" stroke-width=".8" />
  <!-- stairs -->
