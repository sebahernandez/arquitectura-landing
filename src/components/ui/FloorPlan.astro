---
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 392 430" fill="none" stroke="currentColor" stroke-width="1" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <!-- walls -->
  <path d="M0 40h60v70H0M60 40V0M60 110h70v30M0 140h130M130 0v40M0 260h96v90H0M96 260v-40h34M96 350h34v80M130 140v80h-34" />
